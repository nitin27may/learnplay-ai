{
  "name": "learnplay-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm run dev:ui\" \"pnpm run dev:agent\" --names ui,agent --prefix-colors blue,green --kill-others",
    "dev:doppler": "doppler run -- concurrently \"pnpm run dev:ui\" \"pnpm run dev:agent\" --names ui,agent --prefix-colors blue,green --kill-others",
    "dev:debug": "LOG_LEVEL=debug pnpm run dev",
    "dev:agent": "cd agent && pnpm exec langgraphjs dev --port 8123 --no-browser",
    "dev:ui": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "install:agent": "sh ./scripts/setup-agent.sh || scripts\\setup-agent.bat",
    "postinstall": "pnpm run install:agent"
  },
  "dependencies": {
    "@copilotkit/react-core": "^1.90.2",
    "@copilotkit/react-textarea": "^1.90.2",
    "@copilotkit/react-ui": "^1.90.2",
    "@copilotkit/runtime": "^1.90.2",
    "@copilotkit/runtime-client-gql": "^1.90.2",
    "chess.js": "^1.4.0",
    "framer-motion": "^14.14.0",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-chessboard": "4.7.3",
    "react-dom": "^19.3.1",
    "react18-json-view": "^0.2.10"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@langchain/langgraph-cli": "^1.8.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "ignoredBuiltDependencies": [
      "@scarf/scarf"
    ]
  }
}
